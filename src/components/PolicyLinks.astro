---
const links = [
    { href: "/policies/legalNotice/index.html", label: "Legal Notice" },
    { href: "/policies/cookies/index.html", label: "Cookie Policy" },
    { href: "/policies/privacyPolicy/index.html", label: "Privacy Policy" },
    {
        href: "/policies/sustainabilityStatement/index.html",
        label: "Sustainability Statement",
    },
];

const normalize = (path: string) =>
    path.replace(/index\.html$/, "").replace(/\/$/, "");
const currentPath = normalize(Astro.url.pathname);
---

{
    links.map((link) => (
        <a
            href={link.href}
            aria-current={
                currentPath === normalize(link.href) ? "page" : undefined
            }
        >
            {link.label}
        </a>
    ))
}
