---
const links = [
    { href: "/policies/legalNotice/", label: "Legal Notice" },
    { href: "/policies/cookies/", label: "Cookie Policy" },
    { href: "/policies/privacyPolicy/", label: "Privacy Policy" },
    {
        href: "/policies/sustainabilityStatement/",
        label: "Sustainability Statement",
    },
];

const normalize = (path: string) =>
    path.replace(/index\.html$/, "").replace(/\/$/, "");
const currentPath = normalize(Astro.url.pathname);
---

{
    links.map((link) => (
        <a
            href={link.href}
            aria-current={
                currentPath === normalize(link.href) ? "page" : undefined
            }
        >
            {link.label}
        </a>
    ))
}
