---
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
---

<div class="container">
    <LottieAnimation src="coffee.json" autoplay="visible" loop={true} />
</div>

<style>
    .container {
        pointer-events: none;
        position: absolute;
        bottom: 0;
        left: 0;
        width: 50%;
        aspect-ratio: 1 / 1;
    }

    .container :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
    }
    @media only screen and (max-width: 600px) {
        .container {
            display: none;
        }
    }
</style>
