---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";

const { frontmatter, structuredData } = Astro.props;
---

<!doctype html>
<html lang="en">
	<Head {...{ frontmatter, structuredData }} />
	<body>
		<main>
			<slot />
			<Footer />
		</main>
	</body>
</html>

<style>
	body {
		font-family: var(--font-roboto);
		color: #333;
		scroll-behavior: smooth;
	}
	main {
		position: relative;
		min-height: 100lvh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		margin: 0;
	}

</style>

<style is:global>
	section {
		position: relative;
		top: 0;
		display: grid;
		align-items: start;
		grid-template-columns: repeat(12, 1fr);
		height: 100%;
		min-height: 100lvh;
		border-top: 1px solid #b31b1b;
		background: #fefefe;
	}

	section:nth-child(2n) {
		background: #f5f5f7;
	}

	article {
		font-size: 1.25rem;
		line-height: 1.6;
		padding: 2% 5% 0;
	}

	article p {
		margin-bottom: 1.5rem;
	}

	article h2 {
		color: #1a1a1a;
		margin-bottom: 1.5rem;
	}

	article h2 span {
		color: #b31b1b;
		padding-right: 20px;
	}

	article h2 del {
		text-decoration: #b31b1b line-through;
	}

	article h2 del:hover:before {
		content: attr(data-hovertext);
		color: #1bb367;
		font-size: 1.5rem;
	}

	article h2 del:hover {
		font-size: 0;
		text-decoration: none;
	}

	h2 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
		color: #b31b1b;
	}

	a {
		position: relative;
		margin-right: 2rem;
		color: #1a1a1a;
		text-decoration: none;
		font-size: 1.1rem;
	}

	.top {
		display: grid;
		grid-column: 12 / span 1;
		font-size: 1.1rem;
		font-style: normal;
		font-weight: 400;
		letter-spacing: 0.2em;
		line-height: 1;
		color: #ccc;
		text-align: right;
		margin-right: 5px;
	}

	.scroll-container {
		grid-column: 12 / span 1;
		animation: appear 6s;
	}

	@keyframes appear {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@view-transition {
		navigation: auto;
	}

	@media screen and (max-width: 600px) {
		.top {
			display: none;
		}
		.scroll-container {
			display: none;
		}
		article {
			font-size: 1rem;
		}
	}
</style>
